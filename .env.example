# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq AI API calls.
# Add this to your Secrets panel in the AI Studio UI.
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Required for backend database and auth.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Production URL for auth redirects (replace with your actual Vercel URL)
# This ensures OAuth redirects go to production when deployed, not localhost
VITE_APP_URL="https://your-app-name.vercel.app"I1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJyanRuY3p5em9ndXFnaG1jbXBtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM3NDgwMzEsImV4cCI6MjA4OTMyNDAzMX0._Brb7_1FjnnuVVVs3KnDENbljSTUaRMJ4iqsZp3W8ug"

# DAILY.CO: Required for audio/video calls in Language Exchange.
# Get your free API key at https://dashboard.daily.co/developers
VITE_DAILY_API_KEY="your-daily-api-key"
